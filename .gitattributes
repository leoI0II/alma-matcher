# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly text
*.java      text diff=java
*.kt        text
*.kts       text
*.gradle    text
*.properties text
*.xml       text
*.json      text
*.md        text
*.txt       text
*.layout    text
*.glsl      text
*.vert      text
*.frag      text
*.yml       text
*.yaml      text
.gitignore  text
.gitattributes text

# Scripts — line endings matter
*.sh        text eol=lf
gradlew     text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary
*.jar       binary
*.war       binary
*.class     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.mp3       binary
*.ogg       binary
*.wav       binary
*.atlas     text
*.pack      binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary